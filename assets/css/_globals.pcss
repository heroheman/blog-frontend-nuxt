html {
  -ms-text-size-adjust: 100%;
  -webkit-text-size-adjust: 100%;
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  padding: env(safe-area-inset);
  scroll-behavior: smooth;
}

body {
  @apply bg-paper text-ink transition-colors duration-200 ease-in-out;
  font-feature-settings: "kern", "liga", "clig", "calt";
  text-rendering: optimizeLegibility;
}

/* Selection styles */
::selection {
  @apply bg-ink text-paper;
}

::-moz-selection {
  @apply bg-ink text-paper;
}

/* Prose (markdown body) link accent — editorial vintage style */
.prose a {
  @apply text-accent;
  text-decoration-color: theme('colors.accent.200');
}
.prose a:hover {
  @apply text-accent-600;
  text-decoration-color: theme('colors.accent.default');
}

/* Focus styles */
:focus {
  outline: 2px solid transparent;
  outline-offset: 2px;
}

:focus-visible {
  @apply ring-2 ring-gray-400 ring-offset-2;
}
